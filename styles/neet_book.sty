% --- Headers & Footers (Two-Sided Academic Book Standard) ---
\RequirePackage{fancyhdr}
\RequirePackage[breakall]{truncate}
\pagestyle{fancy}
\fancyhf{}

\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

% Even Pages (Left / Verso):
% Left: Page number. Right: Book Series / Title
\fancyhead[LE]{\small\textbf{\color{primarydark}\thepage}}
\fancyhead[RE]{\small\textbf{\color{primarydark}NEET UG 2027 Master Reference Series}}

% Odd Pages (Right / Recto):
% Left: Chapter / Section Mark (Truncated for 6x9 margins). Right: Page number
\fancyhead[LO]{\small\textbf{\color{accentblue}\truncate{0.70\headwidth}{\nouppercase{\leftmark}}}}
\fancyhead[RO]{\small\textbf{\color{primarydark}\thepage}}

\fancyfoot[LE]{\scriptsize\color{gray}Authored by Satya Prakash $\cdot$ spdedsec@hotmail.com}
\fancyfoot[RO]{\scriptsize\color{gray}Master Reference Series $\cdot$ Strictly NMC Calibrated}

\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{accentblue}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{subtleline}\leaders\hrule height \footrulewidth\hfill}}

% Plain Page Style for Chapter Openings
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\textbf{\thepage}}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% Clean Double Page for Two-Sided Printing (Blank pages have no headers/footers)
\makeatletter
\def\cleardoublepage{\clearpage\if@twoside \ifodd\c@page\else
  \hbox{}
  \thispagestyle{empty}
  \newpage
  \if@twocolumn\hbox{}\newpage\fi\fi\fi}
\makeatother

% --- Typography & Sectional Hierarchy ---
\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{titlesec}
\RequirePackage{enumitem}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 2pt minus 1pt}

\setlist[itemize]{leftmargin=1.4em, itemsep=2pt, parsep=0pt, topsep=2pt}
\setlist[enumerate]{leftmargin=1.4em, itemsep=2pt, parsep=0pt, topsep=2pt}

% Part Formatting
\titleformat{\part}[display]
  {\Centering\Huge\bfseries\color{primarydark}}
  {\Large\bfseries\color{accentblue}\MakeUppercase{\partname}\ \thepart}
  {1ex}
  {\color{primarydark}\titlerule[1.5pt]\vspace{1.5ex}}
  [\vspace{1.5ex}{\color{primarydark}\titlerule[1.5pt]}]

% TOC Part Formatting for 6x9 Trade Trim
\makeatletter
\renewcommand*\l@part[2]{%
  \ifnum \c@tocdepth >-2\relax
    \addpenalty{-\@highpenalty}%
    \addvspace{1.2em \@plus\p@}%
    \begingroup
      \parindent \z@ \rightskip 2em
      \parfillskip -2em
      {\leavevmode
       \normalsize\bfseries\color{primarydark}#1\nobreak\hfill\hb@xt@ 2em{\hss #2}\par}%
       \nobreak
         \global\@nobreaktrue
         \everypar{\global\@nobreakfalse\everypar{}}%
    \endgroup
  \fi}
\makeatother

% Chapter Formatting
\titleformat{\chapter}[display]
  {\normalfont\Large\bfseries\color{primarydark}\RaggedRight}
  {\normalsize\bfseries\color{accentblue}\MakeUppercase{\chaptertitlename}\ \thechapter}
  {4pt}
  {\Large\RaggedRight\hyphenpenalty=50}
  [{\color{accentblue}\vspace{4pt}\titlerule[1.5pt]}]

\titlespacing*{\chapter}{0pt}{8pt}{14pt}

% Section Formatting
\titleformat{\section}
  {\large\bfseries\color{primarydark}\RaggedRight}
  {\thesection}{0.8em}{}
  [{\color{accentblue}\titlerule[1.2pt]}]

\titleformat{\subsection}
  {\normalsize\bfseries\color{accentblue}\RaggedRight}
  {\thesubsection}{0.6em}{}

\titleformat{\subsubsection}
  {\small\bfseries\color{primarydark}\RaggedRight}
  {\thesubsubsection}{0.5em}{}

% --- Hyperref Setup ---
\RequirePackage[implicit=false,bookmarks=false,hidelinks,linktoc=none,pdfborder={0 0 0}]{hyperref}

