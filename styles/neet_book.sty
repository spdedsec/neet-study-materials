\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neet_book}[2026/10/15 NEET UG 2027 Professional Master Book Package]

\PassOptionsToPackage{dvipsnames}{xcolor}
\RequirePackage[dvipsnames]{xcolor}

% --- Core Geometry & Layout (Standard 6in x 9in Trade Textbook & Twoside Binding) ---
\RequirePackage[
  paperwidth=6in,
  paperheight=9in,
  top=0.75in,
  bottom=0.70in,
  inner=0.625in,
  outer=0.55in,
  headheight=20pt,
  headsep=12pt,
  footskip=16pt,
  twoside,
  bindingoffset=0.075in
]{geometry}

% --- Math & Physics Symbols ---
\RequirePackage{amsmath,amssymb,amsfonts,mathtools,bm}
\allowdisplaybreaks
\setlength{\jot}{2.5pt}
\RequirePackage{siunitx}
\sisetup{separate-uncertainty = true}

% --- Tables, Landscape & Visual Architecture ---
\RequirePackage{booktabs,tabularx,longtable,array,colortbl,multirow}
\RequirePackage{pdflscape}
\newcolumntype{Y}{>{\Centering\arraybackslash}X}
\newcolumntype{L}{>{\RaggedRight\arraybackslash}X}
\RequirePackage[font=small,labelfont={bf,color=primarydark},justification=RaggedRight,singlelinecheck=false]{caption}
\setlength{\emergencystretch}{2em}

% --- TikZ Vector Graphics Engine ---
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,decorations.pathmorphing,backgrounds,positioning,fit,calc}

