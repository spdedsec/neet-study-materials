% --- Semantic Callout Boxes (tcolorbox) ---
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% 1. Formula Section (Rigorous mathematical equations, limits, variables) - UNBOXED
\newenvironment{formulabox}[1][Master Formula \& Governing Equation]{%
  \par\vspace{9pt}\noindent%
  {\normalsize\bfseries\color{primarydark}\sffamily\RaggedRight #1}\par\vspace{3pt}%
  \ignorespaces%
}{%
  \par\vspace{6pt}%
}

% 2. Use Case & Application Section (Assumptions, valid domains, edge cases, shortcuts) - UNBOXED
\newenvironment{usecasebox}[1][Application Regime, Boundary Conditions \& Shortcuts]{%
  \par\vspace{9pt}\noindent%
  {\normalsize\bfseries\color{primarydark}\sffamily\RaggedRight #1}\par\vspace{3pt}%
  \ignorespaces%
}{%
  \par\vspace{6pt}%
}

% 3. Exam Trap & Pitfall Box (Sign mistakes, units, tricky exceptions, A/R traps)
\newtcolorbox{trapbox}[1][NEET Trap / Common Pitfall / Tricky Exception]{
  enhanced,
  breakable,
  colback=trapbg,
  colframe=traprange,
  coltitle=white,
  fonttitle=\bfseries\small\RaggedRight,
  fontupper=\small,
  title={#1},
  arc=2.0mm,
  boxrule=0.75pt,
  boxsep=1.5pt,
  left=5pt, right=5pt, top=4pt, bottom=4pt
}

% 4. NCERT High-Yield Box (Direct lines, figures, tables, assertion-reason anchors)
\newtcolorbox{ncertbox}[1][Direct NCERT Line / High-Yield Extraction]{
  enhanced,
  breakable,
  colback=ncertbg,
  colframe=ncertgold,
  coltitle=white,
  fonttitle=\bfseries\small\RaggedRight,
  fontupper=\small,
  title={#1},
  arc=2.0mm,
  boxrule=0.75pt,
  boxsep=1.5pt,
  left=5pt, right=5pt, top=4pt, bottom=4pt
}

% 5. Concept Definition Section - UNBOXED
\newenvironment{conceptbox}[1][Core Principle / Theoretical Postulate]{%
  \par\vspace{9pt}\noindent%
  {\normalsize\bfseries\color{primarydark}\sffamily\RaggedRight #1}\par\vspace{3pt}%
  \ignorespaces%
}{%
  \par\vspace{6pt}%
}

% 6. Mentor Note / Conversational Wisdom Box
\newtcolorbox{mentorbox}[1][A Personal Note from Satya]{
